# Microcks the shaper loads into and unloads from.
MICROCKS_URL=http://localhost:8585

# Only needed when Microcks has authentication enabled: a Keycloak service account with the manager role.
# MICROCKS_CLIENT_ID=
# MICROCKS_CLIENT_SECRET=
# Override when the Keycloak URL Microcks advertises is not reachable from where this app runs.
# MICROCKS_KEYCLOAK_URL=
